// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  domain    String?
  createdAt DateTime @default(now())

  users      User[]
  cycles     EvaluationCycle[]
  parameters CompanyParameter[]
}

model CompanyParameter {
  id        String   @id @default(uuid())
  companyId String
  key       String
  value     String   @default("true")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String   @unique
  password  String
  position  String
  level     String?
  role      Role
  area      String
  managerId    String?
  managerEmail String?
  isSuperAdmin Boolean  @default(false)
  isManager    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company               Company       @relation(fields: [tenantId], references: [id])
  manager               User?         @relation("ManagedById", fields: [managerId], references: [id])
  subordinates          User[]        @relation("ManagedById")
  evaluationsAsEmployee Evaluation[]  @relation("EvaluationEmployee")
  evaluationsAsManager  Evaluation[]  @relation("EvaluationManager")
  calibrationsReviewed  Calibration[] @relation("CalibrationReviewer")
  feedbacksSent         Feedback[]    @relation("FeedbackFrom")
  feedbacksReceived     Feedback[]    @relation("FeedbackTo")
  roomParticipations    CalibrationRoomParticipant[]
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

model EvaluationCycle {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  startEmployeeDate    DateTime
  endEmployeeDate      DateTime
  managerAditionalDays Int      @default(0)
  startManagerDate     DateTime?
  endManagerDate       DateTime?
  startCalibrationDate DateTime?
  endCalibrationDate   DateTime?
  target    TargetCycle
  status    CycleStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company           @relation(fields: [tenantId], references: [id])
  evaluations      Evaluation[]
  questions        Question[]
  scale            EvaluationScale[]
  calibrationConfig CalibrationConfig?
  calibrationRooms  CalibrationRoom[]
}

enum TargetCycle {
  ALL
  MANAGERS
  CUSTOM
}

enum CycleStatus {
  DRAFT
  RUNNING
  CALIBRATION
  CLOSED
}

model EvaluationScale {
  id          String  @id @default(uuid())
  cycleId     String
  level       Int
  title       String
  description String

  cycle EvaluationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, level])
}

model Evaluation {
  id         String   @id @default(uuid())
  tenantId   String
  cycleId    String
  employeeId String
  managerId  String
  status     EvaluationStatus

  selfScore        Float?
  managerScore     Float?
  preliminaryScore Float?
  finalScore       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle        EvaluationCycle @relation(fields: [cycleId], references: [id])
  employee     User            @relation("EvaluationEmployee", fields: [employeeId], references: [id])
  manager      User            @relation("EvaluationManager", fields: [managerId], references: [id])
  answers      Answer[]
  calibrations Calibration[]
  roomMemberships CalibrationRoomEvaluation[]
}

enum EvaluationStatus {
  PENDING_SELF_REVIEW
  PENDING_MANAGER_REVIEW
  AWAITING_CALIBRATION
  CALIBRATING
  CLOSED
}

model Question {
  id          String           @id @default(uuid())
  tenantId    String
  cycleId     String
  title       String
  description String?
  category    QuestionCategory
  respondent  QuestionRespondent @default(BOTH)
  weight      Float
  status      QuestionStatus   @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle   EvaluationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  answers Answer[]
}

enum QuestionRespondent {
  EMPLOYEE
  MANAGER
  BOTH
}

enum QuestionCategory {
  PERFORMANCE
  CULTURE
  CAREER
  RESULT
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
}

model Answer {
  id           String     @id @default(uuid())
  evaluationId String
  questionId   String
  type         AnswerType
  score        Float?
  textAnswer   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id])

  @@unique([evaluationId, questionId, type])
}

enum AnswerType {
  SELF
  MANAGER
}

model Feedback {
  id         String @id @default(uuid())
  tenantId   String
  fromUserId String
  toUserId   String
  message    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromUser User @relation("FeedbackFrom", fields: [fromUserId], references: [id])
  toUser   User @relation("FeedbackTo", fields: [toUserId], references: [id])
}

model Calibration {
  id              String  @id @default(uuid())
  evaluationId    String
  reviewerId      String
  calibratedScore Float?
  decision        CalibrationDecision
  comment         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  reviewer   User       @relation("CalibrationReviewer", fields: [reviewerId], references: [id])
}

model CalibrationConfig {
  id              String  @id @default(uuid())
  cycleId         String  @unique
  tenantId        String
  model           String  @default("HYBRID")
  calibrableField String  @default("PERFORMANCE")
  roomFormation   String  @default("RULE")
  configData      Json?
  isPublished     Boolean @default(false)
  publishedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle EvaluationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
}

enum CalibrationDecision {
  AGREE
  DISAGREE
  ADJUST
  PENDING
}

model CalibrationRoom {
  id       String @id @default(uuid())
  cycleId  String
  tenantId String
  name     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle        EvaluationCycle               @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  evaluations  CalibrationRoomEvaluation[]
  participants CalibrationRoomParticipant[]

  @@unique([cycleId, name])
}

model CalibrationRoomEvaluation {
  roomId       String
  evaluationId String

  room       CalibrationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  evaluation Evaluation      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@id([roomId, evaluationId])
  @@unique([evaluationId])
}

model CalibrationRoomParticipant {
  roomId String
  userId String
  role   String @default("REVIEWER")

  room CalibrationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
}

model AuditLog {
  id        String @id @default(uuid())
  tenantId  String

  actorId   String
  entity    String
  entityId  String
  action    String

  before    Json?
  after     Json?

  createdAt DateTime @default(now())
}